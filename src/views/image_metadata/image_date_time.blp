using Gtk 4.0;
using Adw 1;

template $ImageDateTimeView: Adw.Bin {
  // A container is strictly needed here because I need to manipulate
  // the visible state in order to have a consistent height on the main
  // window content. Check setup_tab_switch_listener for more context.
  Gtk.Box container {
    orientation: vertical;
    spacing: 24;

    Adw.PreferencesGroup general_fields_group {
      Adw.EntryRow creation_date_entry {
        title: _("Creation Date");
      }

      Adw.EntryRow creation_time_entry {
        title: _("Creation Time");
      }

      Adw.ComboRow timezone_combo {
        title: _("Time Zone");
      }
    }

    Adw.PreferencesGroup {
      Adw.SwitchRow advanced_options_switch {
        title: _("Advanced Options");
      }
    }

    Gtk.Revealer advanced_revelear {
      reveal-child: false;
      transition-type: slide_down;
      transition-duration: 200;

      Gtk.Box {
        orientation: vertical;
        spacing: 24;

        Adw.PreferencesGroup {
          title: _("Modify Date");
          description: _("File Modification Time");

          Adw.EntryRow modify_date_entry {
            title: _("Date");
          }

          Adw.EntryRow sub_sec_time_entry {
            title: _("Fractional Seconds");
          }

          Adw.EntryRow offset_time_entry {
            title: _("Offset Time");
          }
        }

        Adw.PreferencesGroup {
          title: _("Date Time Original");
          description: _("Shutter click time");

          Adw.EntryRow date_time_original_entry {
            title: _("Date");
          }

          Adw.EntryRow sub_sec_time_original_entry {
            title: _("Fractional Seconds");
          }

          Adw.EntryRow offset_time_original_entry {
            title: _("Offset Time");
          }
        }

        Adw.PreferencesGroup {
          title: _("Create Date");
          description: _("Digitization time");

          Adw.EntryRow create_date_entry {
            title: _("Date");
          }

          Adw.EntryRow sub_sec_time_digitized_entry {
            title: _("Fractional Seconds");
          }

          Adw.EntryRow offset_time_digitized_entry {
            title: _("Offset Time");
          }
        }
      }
    }
  }
}
