using Gtk 4.0;
using Adw 1;

template $ImageDetailsView: Adw.Bin {
  Gtk.Box container {
    orientation: vertical;
    spacing: 24;

    Adw.PreferencesGroup {
      Adw.ActionRow {
        title: _("Description");

        Entry image_description_entry {
          width-chars: 20;
          valign: center;
        }
      }
    }
  }
}
