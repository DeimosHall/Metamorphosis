using Gtk 4.0;
using Adw 1;

template $ImageCameraLensView: Adw.Bin {
  // A container is strictly needed here because I need to manipulate
  // the visible state in order to have a consistent height on the main
  // window content. Check setup_tab_switch_listener for more context.
  Gtk.Box container {
    orientation: vertical;
    spacing: 24;

    Adw.PreferencesGroup {
      title: _("Device");

      Adw.EntryRow manufacturer_entry {
        title: _("Manufacturer");
      }

      Adw.EntryRow model_entry {
        title: _("Model");
      }

      Adw.EntryRow serial_number_entry {
        title: _("Serial Number");
      }

      Adw.EntryRow owner_name_entry {
        title: _("Owner Name");
      }

      Adw.EntryRow camera_serial_number_entry {
        title: _("Camera Serial Number");
      }

      Adw.EntryRow camera_firmware_entry {
        title: _("Camera Firmware");
      }

      Adw.EntryRow camera_label_entry {
        title: _("Camera Label");
      }

      Adw.EntryRow localized_camera_model_entry {
        title: _("Localized Camera Model");
      }

      Adw.EntryRow image_unique_id_entry {
        title: _("Image Unique ID");
      }
    }

    Adw.PreferencesGroup {
      title: _("Lens");

      Adw.EntryRow lens_make_entry {
        title: _("Lens Make");
      }

      Adw.EntryRow lens_model_entry {
        title: _("Lens Model");
      }

      Adw.EntryRow lens_serial_number_entry {
        title: _("Lens Serial Number");
      }

      Adw.EntryRow lens_info_entry {
        title: _("Lens Info");
      }

      Adw.EntryRow max_aperture_value_entry {
        title: _("Max Aperture Value");
      }
    }

    Adw.PreferencesGroup {
      title: _("Exposure Settings");

      Adw.EntryRow exposure_time_entry {
        title: _("Exposure Time");
      }

      Adw.EntryRow fnumber_entry {
        title: _("F-Number");
      }

      Adw.EntryRow exposure_program_entry {
        title: _("Exposure Program");
      }

      Adw.EntryRow iso_entry {
        title: _("ISO");
      }

      Adw.EntryRow focal_length_entry {
        title: _("Focal Length");
      }

      Adw.EntryRow exposure_compensation_entry {
        title: _("Exposure Compensation");
      }

      Adw.EntryRow metering_mode_entry {
        title: _("Metering Mode");
      }

      Adw.EntryRow flash_entry {
        title: _("Flash");
      }

      Adw.EntryRow white_balance_entry {
        title: _("White Balance");
      }
    }
  }
}
