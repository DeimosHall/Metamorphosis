msgid "Add new General and Advanced tabs"
msgstr "Agregar nuevas pestañas General y Avanzado"

#: data/dev.deimoshall.Metamorphosis.metainfo.xml.in.in:110
msgid "General tab for most common tags"
msgstr "Pestaña general para las etiquetas más comunes"

#: data/dev.deimoshall.Metamorphosis.metainfo.xml.in.in:111
