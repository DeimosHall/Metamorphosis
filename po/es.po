#: data/dev.deimoshall.Metamorphosis.metainfo.xml.in.in:113
msgid "Fix remove button stopped working"
msgstr "Arreglar el botón de remover dejo de funcionar"

#: data/dev.deimoshall.Metamorphosis.metainfo.xml.in.in:119
msgid "Add manufacturer and model fields"
msgstr "Agregar campos de fabricante y modelo"

#: data/dev.deimoshall.Metamorphosis.metainfo.xml.in.in:124
msgid "Add description field"
msgstr "Agregar campo de descripción"

#: data/dev.deimoshall.Metamorphosis.metainfo.xml.in.in:129
msgid "Update runtime to GNOME 50"
msgstr "Actualizar entorno de ejecución a GNOME 50"

#: data/dev.deimoshall.Metamorphosis.metainfo.xml.in.in:134
msgid "Fix ExifTool execution fail due to Perl interpreter not available"
